      "type": "SetTile",
      "args": {
        "latitude": "45"
      }
    },
    {
      "type": "SetSeason",
      "args": {
        "dayOfYear": "40"
      }
    },
    {
      "type": "SetFeature",
      "args": {
        "featureName": "realistic_preset",
        "enabled": "false"
      }
    },
    {
      "type": "SetWeather",
      "args": {
        "weatherDef": "Clear",
        "instant": "true"
      }
    },
    {
      "type": "SetFeature",
