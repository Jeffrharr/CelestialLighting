{"name":"vector_light_blockers","saveFile":"minimal_colony.rws","description":"\u00a727: open ground, one torch, two loose wall blocks below it, midnight. Vanilla casts nothing at all here \u2014 its grid records how far light travelled and never which way it came \u2014 so the two diverging shadow wedges are the whole test.","steps":[{"type":"SetTile","args":{"latitude":"45"}},{"type":"SetSeason","args":{"dayOfYear":"40"}},{"type":"SetWeather","args":{"weatherDef":"Clear","instant":"true"}},{"type":"SetTerrain","args":{"def":"Concrete","width":"40","height":"24","offset":"0,45","clear":"true"}},{"type":"PlaceThings","args":{"def":"Wall","stuff":"BlocksGranite","offset":"0,45","layout":"cells","clear":"true","cells":"-4,-1; -3,-1; 3,-1; 4,-1"}},{"type":"PlaceThings","args":{"def":"TorchLamp","offset":"0,45","layout":"cells","cells":"0,5"}},{"type":"SetTime","args":{"hour":"0"}},{"type":"LookAt","args":{"offset":"0,45","zoom":"22"}},{"type":"Probe","args":{"probeName":"vector_light_count","expectedValue":"4","tolerance":"0"}},{"type":"Probe","args":{"probeName":"vector_light_lit_area","expectedValue":"600.608398","tolerance":"2"}},{"type":"Probe","args":{"probeName":"vector_light_shadow_fraction","expectedValue":"0.0782372206","tolerance":"0.01"}},{"type":"Probe","args":{"probeName":"vector_light_verts","expectedValue":"440","tolerance":"6"}},{"type":"Screenshot","args":{"fileName":"warmup_discard.png"}},{"type":"SetFeature","args":{"featureName":"vector_lights","enabled":"false"}},{"type":"Screenshot","args":{"fileName":"blockers_off.png"}},{"type":"SetFeature","args":{"featureName":"vector_lights","enabled":"true"}},{"type":"Screenshot","args":{"fileName":"blockers_on.png"}}]}