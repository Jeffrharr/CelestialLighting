{
  "name": "vacuum_suppression",
  "saveFile": "minimal_colony.rws",
  "steps": [
    { "type": "SetFeature", "args": { "featureName": "pitch_black_nights", "enabled": "false" } },

    { "type": "SetTile", "args": { "latitude": "45" } },
    { "type": "SetSeason", "args": { "dayOfYear": "40" } },
    { "type": "LookAt", "args": { "zoom": "18" } },

    { "type": "SetTime", "args": { "hour": "19" } },
    { "type": "StartCondition", "args": { "conditionDef": "SolarFlare", "durationHours": "24", "agedHours": "2" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Probe", "args": { "probeName": "twilight_warmth", "expectedValue": "0.3520", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "sky_color_temperature", "expectedValue": "2851.66", "tolerance": "20" } },
    { "type": "Probe", "args": { "probeName": "aurora_tint", "expectedValue": "0.0388", "tolerance": "0.01" } },
    { "type": "Screenshot", "args": { "fileName": "vac_ground_lowsun_on.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "false" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "vac_ground_lowsun_off.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "true" } },

    { "type": "SetTime", "args": { "hour": "21" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Probe", "args": { "probeName": "twilight_warmth", "expectedValue": "0.1531", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "sky_color_temperature", "expectedValue": "2000", "tolerance": "20" } },
    { "type": "Probe", "args": { "probeName": "aurora_tint", "expectedValue": "0.18", "tolerance": "0.01" } },
    { "type": "Screenshot", "args": { "fileName": "vac_ground_twilight_on.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "false" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "vac_ground_twilight_off.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "true" } },

    { "type": "SetTime", "args": { "hour": "22" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Probe", "args": { "probeName": "twilight_warmth", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Probe", "args": { "probeName": "sky_color_temperature", "expectedValue": "2000", "tolerance": "20" } },
    { "type": "Probe", "args": { "probeName": "aurora_tint", "expectedValue": "0.18", "tolerance": "0.01" } },
    { "type": "Screenshot", "args": { "fileName": "vac_ground_night_on.png" } },

    { "type": "LandInOrbit", "args": { "latitude": "45", "mapSize": "150" } },
    { "type": "SetTerrain", "args": { "def": "OrbitalPlatform", "width": "30", "height": "30" } },
    { "type": "PlaceThings", "args": { "def": "Wall", "stuff": "Steel", "layout": "grid", "cols": "3", "rows": "3", "spacing": "6" } },
    { "type": "LookAt", "args": { "zoom": "18" } },
    { "type": "SetSeason", "args": { "dayOfYear": "40" } },

    { "type": "SetTime", "args": { "hour": "19" } },
    { "type": "StartCondition", "args": { "conditionDef": "SolarFlare", "durationHours": "24", "agedHours": "2" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Probe", "args": { "probeName": "twilight_warmth", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Probe", "args": { "probeName": "sky_color_temperature", "expectedValue": "5772", "tolerance": "1" } },
    { "type": "Probe", "args": { "probeName": "aurora_tint", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Screenshot", "args": { "fileName": "vac_orbit_lowsun_on.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "false" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "vac_orbit_lowsun_off.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "true" } },

    { "type": "SetTime", "args": { "hour": "21" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Probe", "args": { "probeName": "twilight_warmth", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Probe", "args": { "probeName": "sky_color_temperature", "expectedValue": "5772", "tolerance": "1" } },
    { "type": "Probe", "args": { "probeName": "aurora_tint", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Screenshot", "args": { "fileName": "vac_orbit_twilight_on.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "false" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "false" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Screenshot", "args": { "fileName": "vac_orbit_twilight_off.png" } },
    { "type": "SetFeature", "args": { "featureName": "civil_twilight", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "sky_color_temperature", "enabled": "true" } },
    { "type": "SetFeature", "args": { "featureName": "aurora", "enabled": "true" } },

    { "type": "SetTime", "args": { "hour": "22" } },
    { "type": "Wait", "args": { "frames": "10" } },
    { "type": "Probe", "args": { "probeName": "twilight_warmth", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Probe", "args": { "probeName": "sky_color_temperature", "expectedValue": "5772", "tolerance": "1" } },
    { "type": "Probe", "args": { "probeName": "aurora_tint", "expectedValue": "0", "tolerance": "0.005" } },
    { "type": "Screenshot", "args": { "fileName": "vac_orbit_night_on.png" } },

    {
      "type": "Assert",
      "args": {
        "kind": "vision",
        "images": "vac_ground_twilight_on.png, vac_ground_twilight_off.png, vac_orbit_twilight_on.png, vac_orbit_twilight_off.png",
        "expect": "The ground pair differs in sky colour; the orbital pair does not, because the vacuum gate has already suppressed all three colour effects.",
        "prompt": "Four RimWorld frames at the same latitude (45), day (40) and hour (21). Frames 1 and 2 are a planet surface with CelestialLighting's colour effects on and off. Frames 3 and 4 are an Odyssey orbital platform in open space above a planet, same effects on and off. Confirm: (1) frames 3 and 4 show a square platform against space and a planet below, not a planet surface map; (2) frame 1 has a visibly warmer/oranger or greener colour cast than frame 2; (3) frames 3 and 4 look essentially identical to each other in colour cast. Fail if frames 3 and 4 differ in colour from one another, or if frames 1 and 2 look identical."
      }
    }
  ]
}
