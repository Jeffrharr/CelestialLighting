{
  "name": "purple_light",
  "saveFile": "minimal_colony.rws",
  "steps": [
    { "type": "SetTile", "args": { "latitude": "45" } },
    { "type": "SetSeason", "args": { "dayOfYear": "11" } },

    { "type": "SetTime", "args": { "hour": "20.05" } },
    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "-3.2133", "tolerance": "0.05" } },
    { "type": "Probe", "args": { "probeName": "purple_light", "expectedValue": "0.0", "tolerance": "0.001" } },
    { "type": "Probe", "args": { "probeName": "purple_hue_green", "expectedValue": "1.0", "tolerance": "0.001" } },

    { "type": "SetTime", "args": { "hour": "20.10" } },
    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "-4.0512", "tolerance": "0.05" } },
    { "type": "Probe", "args": { "probeName": "purple_light", "expectedValue": "0.0998", "tolerance": "0.01" } },

    { "type": "SetTime", "args": { "hour": "20.15" } },
    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "-4.8913", "tolerance": "0.05" } },
    { "type": "Probe", "args": { "probeName": "purple_light", "expectedValue": "0.9882", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_hue_green", "expectedValue": "0.8548", "tolerance": "0.005" } },

    { "type": "SetTime", "args": { "hour": "20.20" } },
    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "-5.7331", "tolerance": "0.05" } },
    { "type": "Probe", "args": { "probeName": "purple_light", "expectedValue": "0.4625", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_hue_green", "expectedValue": "0.8339", "tolerance": "0.005" } },

    { "type": "SetTime", "args": { "hour": "20.25" } },
    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "-6.5767", "tolerance": "0.05" } },
    { "type": "Probe", "args": { "probeName": "purple_light", "expectedValue": "0.0", "tolerance": "0.001" } },
    { "type": "Probe", "args": { "probeName": "purple_hue_green", "expectedValue": "1.0", "tolerance": "0.001" } },

    { "type": "SetTime", "args": { "hour": "20.15" } },
    { "type": "SetFeature", "args": { "featureName": "purple_light", "enabled": "false" } },
    { "type": "Probe", "args": { "probeName": "purple_light", "expectedValue": "0.0", "tolerance": "0.001" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_red", "expectedValue": "0.2662", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_green", "expectedValue": "0.2848", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_blue", "expectedValue": "0.3130", "tolerance": "0.01" } },
    { "type": "Screenshot", "args": { "fileName": "purple_off.png" } },
    { "type": "SetFeature", "args": { "featureName": "purple_light", "enabled": "true" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_red", "expectedValue": "0.3271", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_green", "expectedValue": "0.2884", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_blue", "expectedValue": "0.3130", "tolerance": "0.01" } },
    { "type": "Screenshot", "args": { "fileName": "purple_on.png" } },

    { "type": "SetTime", "args": { "hour": "20.17" } },
    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "-5.2278", "tolerance": "0.05" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_red", "expectedValue": "0.3161", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_green", "expectedValue": "0.2856", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_blue", "expectedValue": "0.3225", "tolerance": "0.01" } },
    { "type": "Screenshot", "args": { "fileName": "purple_lavender.png" } },

    { "type": "SetTime", "args": { "hour": "20.20" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_red", "expectedValue": "0.2650", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_green", "expectedValue": "0.2761", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_blue", "expectedValue": "0.3370", "tolerance": "0.01" } },
    { "type": "SetFeature", "args": { "featureName": "purple_light", "enabled": "false" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_red", "expectedValue": "0.2295", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_green", "expectedValue": "0.2716", "tolerance": "0.01" } },
    { "type": "Probe", "args": { "probeName": "purple_sky_blue", "expectedValue": "0.3370", "tolerance": "0.01" } },
    { "type": "SetFeature", "args": { "featureName": "purple_light", "enabled": "true" } },

    { "type": "SetTime", "args": { "hour": "20.35" } },
    { "type": "SetFeature", "args": { "featureName": "purple_light", "enabled": "false" } },
    { "type": "Screenshot", "args": { "fileName": "purple_outside_off.png" } },
    { "type": "SetFeature", "args": { "featureName": "purple_light", "enabled": "true" } },
    { "type": "Screenshot", "args": { "fileName": "purple_outside_on.png" } }
  ]
}
