      }
    },
    {
      "type": "LookAt",
      "args": {
        "anchor": "125,125",
        "zoom": "38"
      }
    },
    {
      "type": "Screenshot",
      "args": {
        "fileName": "bake_raymarched"
      }
    },
    {
      "type": "Probe",
      "args": {
