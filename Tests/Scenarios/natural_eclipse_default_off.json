{
  "name": "natural_eclipse_default_off",
  "saveFile": "minimal_colony.rws",
  "steps": [
    { "type": "SetTile", "args": { "latitude": "20" } },
    { "type": "SetSeason", "args": { "dayOfYear": "40" } },
    { "type": "SetTime", "args": { "hour": "11" } },
    { "type": "SetFeature", "args": { "featureName": "eclipse_stage_alignment", "enabled": "true" } },
    { "type": "FastForward", "args": { "ticks": "3000" } },
    { "type": "Probe", "args": { "probeName": "eclipse_coverage", "expectedValue": "0.0", "tolerance": "0.001" } },
    { "type": "Screenshot", "args": { "fileName": "natural_eclipse_default_off.png" } }
  ]
}
