{
  "name": "vacuum_night_floor_ab",
  "saveFile": "minimal_colony.rws",
  "steps": [
    { "type": "LandInOrbit", "args": { "latitude": "45", "mapSize": "150" } },
    { "type": "SetTerrain", "args": { "def": "OrbitalPlatform", "width": "30", "height": "30" } },
    { "type": "PlaceThings", "args": { "def": "Wall", "stuff": "Steel", "layout": "grid", "cols": "3", "rows": "3", "spacing": "6" } },
    { "type": "LookAt", "args": { "zoom": "18" } },

    { "type": "SetSeason", "args": { "dayOfYear": "30" } },
    { "type": "SetTime", "args": { "hour": "0" } },
    { "type": "Wait", "args": { "frames": "10" } },

    { "type": "Probe", "args": { "probeName": "sun_elevation", "expectedValue": "0", "tolerance": "99" } },
    { "type": "Probe", "args": { "probeName": "night_radiance", "expectedValue": "0", "tolerance": "99" } },
    { "type": "Probe", "args": { "probeName": "sky_glow", "expectedValue": "0", "tolerance": "99" } },
    { "type": "Screenshot", "args": { "fileName": "vnf_orbit_ab.png" } }
  ]
}
