<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Links the actual shipped Source/Formulas.cs into this project (not a copy) so the pure
       formula unit tests exercise exactly the code that runs inside RimWorld. Formulas.cs has no
       UnityEngine/Verse dependency, so it compiles cleanly under net8.0 as-is. -->
  <ItemGroup>
    <Compile Include="../../Source/Formulas.cs" Link="Formulas.cs" />
    <Compile Include="../../Source/PenumbraMath.cs" Link="PenumbraMath.cs" />
    <Compile Include="../../Source/MoonMath.cs" Link="MoonMath.cs" />
    <!-- Subsystem 6b pure core (absolute illuminance in lux, and the shadow contrast that follows
         from it). MoonMath depends on it for moon-shadow strength, and it depends on Formulas for
         the shared refraction horizon — both already linked above. -->
    <Compile Include="../../Source/IlluminanceMath.cs" Link="IlluminanceMath.cs" />
    <Compile Include="../../Source/NightRadianceMath.cs" Link="NightRadianceMath.cs" />
    <!-- §18b's vacuum arm of the night floor. Sits below NightRadianceMath (which dispatches into
         it) and above IlluminanceMath (whose lux anchors the planetshine integral samples). -->
    <Compile Include="../../Source/VacuumRadianceMath.cs" Link="VacuumRadianceMath.cs" />
    <Compile Include="../../Source/PurkinjeMath.cs" Link="PurkinjeMath.cs" />
    <!-- §9's per-cell half. Depends on PurkinjeMath above for its lit-exempt anchor, so the two are
         linked together and tested together. -->
    <Compile Include="../../Source/NightDesaturationMath.cs" Link="NightDesaturationMath.cs" />
    <!-- §9's scratch lattice. Verse-free by design (the glow reads happen in the layer and are handed
         in), so the equivalence test can drive the real vertex loop offline. Depends on
         NightDesaturationMath above for CellWash and WashAlpha. -->
    <Compile Include="../../Source/NightWashWindow.cs" Link="NightWashWindow.cs" />
    <!-- Subsystem 13 pure core (weather dimming). Verse-free, so it compiles under net8.0 as-is.
         WeatherDimmingMathTests also exercises PurkinjeMath above, since §13's whole purpose is to
         feed §9 an apparent brightness that finally varies with weather. -->
    <Compile Include="../../Source/WeatherDimmingMath.cs" Link="WeatherDimmingMath.cs" />
    <!-- §22's Clear-weather cloud-cover sky tint. Depends on WeatherDimmingMath above for its
         classification anchors (Clear/Overcast luminance and saturation) rather than duplicating
         them — see CloudCoverSky.cs's header for why reusing vanilla's own overcast destination
         palette is the point. -->
    <Compile Include="../../Source/CloudCoverSky.cs" Link="CloudCoverSky.cs" />
    <!-- §22's weather-panel suffix: the percentage arithmetic, and the one-line fit rule that decides
         whether the suffix is drawn at all when another mod has appended to the same label. The fit
         rule is the half worth testing offline — Patch_CloudCoverLabel measures the string and this
         decides, so every boundary (exact fit, one pixel over, an unmeasurable width) is reachable
         here without a running game. -->
    <Compile Include="../../Source/CloudCoverLabelMath.cs" Link="CloudCoverLabelMath.cs" />
    <Compile Include="../../Source/MapSkyMath.cs" Link="MapSkyMath.cs" />
    <!-- Subsystem 8 pure core. Depends on Formulas.AtmosphericRefractionDegrees, so Formulas.cs
         above must be linked too (it already is). -->
    <Compile Include="../../Source/SkyColorTemperature.cs" Link="SkyColorTemperature.cs" />
    <!-- §20's shared atmospheric column model (barometric scale height -> what fraction of a
         scattering species is still overhead at a given site altitude). Linked directly below
         SkyColorTemperature because that is its only consumer today and SkyColorTemperatureTests
         drives both — the site-altitude cases pin the column fractions and the colour-temperature
         endpoints they produce in the same file, so a change to the scale height shows up as a
         moved sky colour rather than only as a moved intermediate. It has no dependencies of its
         own (MathF only), so it can sit anywhere in this list; it is here for readability.
         Issue #83 adds an aerosol scale height to the same file, which needs no new link entry. -->
    <Compile Include="../../Source/AtmosphericColumn.cs" Link="AtmosphericColumn.cs" />
    <!-- §20c's day-to-day air-mass drift: the multiplier that stops two consecutive evenings on one
         map being pixel-identical. Sits next to AtmosphericColumn because it drives that file's
         aerosol column, and it depends on AuroraNoise (linked further down — order does not matter
         to the compiler) for the value-noise field itself rather than carrying a second copy. The
         live half that reads the tick and the tile id is AerosolDriftClock.cs and is NOT linked:
         it is Verse-bound by design, which is the whole point of the split. -->
    <!-- Shared hourly-sampled lattice-noise engine behind AerosolDrift below and §22's CloudCoverDrift.
         No dependencies of its own besides AuroraNoise (linked further down — order does not matter to
         the compiler), so it sits here for readability, next to its first consumer. -->
    <Compile Include="../../Source/LatticeDriftNoise.cs" Link="LatticeDriftNoise.cs" />
    <Compile Include="../../Source/AerosolDrift.cs" Link="AerosolDrift.cs" />
    <!-- §22's partial cloud cover during Clear weather. SeasonalWetFraction has no dependencies of
         its own; CloudCoverDrift depends on LatticeDriftNoise above for its noise field, the same
         way AerosolDrift does, and composes with SeasonalWetFraction's output rather than depending
         on that file directly (see CloudCoverDrift.cs's header for why the classifier and the noise
         engine stay in separate files). The live half that reads the tick, the tile, and the biome
         is CloudCoverClock.cs and is NOT linked, same reason as AerosolDriftClock.cs above. -->
    <Compile Include="../../Source/SeasonalWetFraction.cs" Link="SeasonalWetFraction.cs" />
    <Compile Include="../../Source/CloudCoverDrift.cs" Link="CloudCoverDrift.cs" />
    <!-- Subsystem 20d pure core (aerosol spectral shape / Angstrom exponent). Like OzoneTwilightMath
         below it reuses SkyColorTemperature.Rgb as its colour struct, so the SkyColorTemperature
         link above is a hard prerequisite. Its tests live in SkyColorTemperatureTests.cs rather than
         a file of their own: every invariant worth pinning is about how this model composes with §8's
         curve (does alpha = 4 reproduce the Kelvin ramp's own Rayleigh shape, is an unpolluted tile
         still bit-identical), and splitting those across two files would separate each assertion from
         the curve it is an assertion about. -->
    <Compile Include="../../Source/AerosolSpectrum.cs" Link="AerosolSpectrum.cs" />
    <!-- Subsystem 19 pure core (polar night blue / Chappuis ozone twilight). Reuses
         SkyColorTemperature.Rgb as its colour struct, so the link above is a hard prerequisite —
         but deliberately NOT its BlackbodyToRgb: §19 models an absorption notch, not a Planckian
         locus, and OzoneTwilightMath's header records why the blackbody version was invisible.
         OzoneTwilightMathTests also cross-checks against Formulas.SolarElevationDegrees when it
         proves the reachability gate never skips a reachable day. -->
    <Compile Include="../../Source/OzoneTwilightMath.cs" Link="OzoneTwilightMath.cs" />
    <!-- §19c's purple light. It is a composition ABOVE §8 and §19 rather than a fourth independent
         model, so it references both of the two files above: SkyColorTemperature for the reddened
         source spectrum and its Rgb struct, OzoneTwilightMath for the Chappuis notch, the window's
         upper boundary and the cross sections its refutation arithmetic needs. -->
    <Compile Include="../../Source/PurpleLightMath.cs" Link="PurpleLightMath.cs" />
    <Compile Include="../../Source/AuroraMath.cs" Link="AuroraMath.cs" />
    <!-- §11a's curtain generator. AuroraCurtain references AuroraMath.Rgb and its two oxygen-line
         colours, so the link above is a hard prerequisite for this pair. -->
    <Compile Include="../../Source/AuroraNoise.cs" Link="AuroraNoise.cs" />
    <Compile Include="../../Source/AuroraCurtain.cs" Link="AuroraCurtain.cs" />
    <!-- The alternative §11a shape function under evaluation (issue #42). Depends on AuroraCurtain
         for Amplify and PaletteColor, so the link above is a hard prerequisite for this one. -->
    <Compile Include="../../Source/AuroraCurtainHemRays.cs" Link="AuroraCurtainHemRays.cs" />
    <Compile Include="../../Source/AuroraFieldSpec.cs" Link="AuroraFieldSpec.cs" />
    <Compile Include="../../Source/AuroraSheetLayout.cs" Link="AuroraSheetLayout.cs" />
    <!-- §11a's display schedule. Mutually dependent with AuroraSheetLayout above — the layout reads
         AuroraDisplays.MinPeakAlpha, the schedule sizes itself off AuroraSheetLayout.MaxSheets — and it
         reuses AuroraMath.ConditionRampFactor for the per-display fade, so all three link together. -->
    <Compile Include="../../Source/AuroraDisplays.cs" Link="AuroraDisplays.cs" />
    <Compile Include="../../Source/EclipseMath.cs" Link="EclipseMath.cs" />
    <!-- §18e's vacuum eclipse response. Depends on EclipseMath above (it samples the same
         disc-overlap coverage ramp the shipped patch drives) and on NightRadianceMath, whose §7a
         glow->screen curve it reuses rather than inventing a second one. -->
    <Compile Include="../../Source/VacuumEclipseMath.cs" Link="VacuumEclipseMath.cs" />
    <Compile Include="../../Source/EclipseStaging.cs" Link="EclipseStaging.cs" />
    <Compile Include="../../Source/EclipseModeRules.cs" Link="EclipseModeRules.cs" />
    <Compile Include="../../Source/EclipseSettings.cs" Link="EclipseSettings.cs" />
    <Compile Include="../../Source/BloodMoonMath.cs" Link="BloodMoonMath.cs" />
    <Compile Include="../../Source/CelestialSettingsMath.cs" Link="CelestialSettingsMath.cs" />
    <!-- Subsystem 7b pure core (indoor sky occlusion). Verse-free, so it compiles under net8.0 as-is. -->
    <Compile Include="../../Source/IndoorOcclusionMath.cs" Link="IndoorOcclusionMath.cs" />
    <!-- Which under-roof sky source answers a cell. Pure ordering logic, linked so the seam rule (an
         owning mod's zero is a real zero, not an invitation for §7c to fill in) is testable offline. -->
    <Compile Include="../../Source/SkyFalloffArbitration.cs" Link="SkyFalloffArbitration.cs" />
    <!-- §7b's baked verdict window: geometry, storage and reads only, so it is Verse-free too and the
         lattice-equivalence tests can drive the real shipped buffer rather than a stand-in. -->
    <Compile Include="../../Source/SkyOcclusionWindow.cs" Link="SkyOcclusionWindow.cs" />
    <!-- §7c pure core (native under-roof sky falloff, no Ambient Light dependency). Mirrors
         IndoorOcclusionMath's AmbientLightSkyFraction in shape but is its own file and its own
         formula, deliberately not shared code — see its header. -->
    <Compile Include="../../Source/NativeSkyFalloffMath.cs" Link="NativeSkyFalloffMath.cs" />
    <!-- §7d pure core (door-strength weighting for §7c's BFS): how much a door DIMS the flood's running
         strength as it crosses, keyed off its ThingDef.BaseMaxHitPoints against a vanilla wood Door's —
         deliberately not extra BFS distance, see the file's own header. Its own file and its own
         formula for the same reason NativeSkyFalloffMath is not shared with IndoorOcclusionMath. -->
    <Compile Include="../../Source/DoorLeakMath.cs" Link="DoorLeakMath.cs" />
    <!-- §7b staleness-fix pure core: has a map's CurSkyGlow drifted far enough from what its lighting
         meshes were last baked against to justify another whole-map rebuild. See
         GameComponent_SkyFalloffRedraw for the live half and why this is a drift gate, not a clock. -->
    <Compile Include="../../Source/SkyFalloffRedrawMath.cs" Link="SkyFalloffRedrawMath.cs" />
    <!-- Subsystem 14 pure core (sun-clock reconciliation). Depends on Formulas.cs, already linked. -->
    <Compile Include="../../Source/SunClockMath.cs" Link="SunClockMath.cs" />
    <!-- Subsystem 18d pure core (limb refraction on vacuum maps). Depends on Formulas for the
         sea-level refraction horizon it measures its sunlit overshoot against, on SunClockMath
         (directly above) for the elevation->glow curve it re-references to the platform's own
         horizon, and on BloodMoonMath for the Rec. 601 luma weights — all three already linked. -->
    <Compile Include="../../Source/LimbRefractionMath.cs" Link="LimbRefractionMath.cs" />
    <!-- Subsystem 15 pure core (eaves). Verse-free, so it compiles under net8.0 as-is. Shared by
         §4's shadow mesh and §7b's occlusion, which is the whole reason it is its own file. -->
    <Compile Include="../../Source/EavesMath.cs" Link="EavesMath.cs" />
    <!-- Subsystem 15b pure core (how dark the ground under an eave is). Reads one constant off
         IndoorOcclusionMath, already linked above. -->
    <Compile Include="../../Source/EaveShadeMath.cs" Link="EaveShadeMath.cs" />
    <!-- Subsystem 18c pure core (what fills a shadow: skylight at sea level, the night light budget
         in vacuum). Reads EaveShadeMath's Rec. 709 helper above so there is one copy of those
         weights, and its tests read NightRadianceMath's floor constants so the vacuum umbra is
         pinned to the night budget it consumes rather than to a second copy of it. Both already
         linked above. -->
    <Compile Include="../../Source/ShadowFillMath.cs" Link="ShadowFillMath.cs" />
    <!-- Subsystem 21 pure core (the surface-cloud light cavity: how much brighter weather buildup
         plus a cloud deck make a map than the bare ground the mod's brightness anchors were
         calibrated on). Verse-free and dependency-free — it does not even read Formulas — but its
         tests deliberately compose it with WeatherDimmingMath.SkyTintFactor above, because the
         headline inversion (snowy overcast brighter than snowy CLEAR sky) is a claim about the two
         channels together: §21 lifts .glow, §13 dims the colour, and only their product is what the
         screen shows. -->
    <Compile Include="../../Source/AlbedoCavityMath.cs" Link="AlbedoCavityMath.cs" />
    <!-- §24's glare residual (issue #90). Compiled alongside AlbedoCavityMath above rather than on
         its own because the property worth testing is a RELATIONSHIP between the two: what
         RecoveredDimming's clamp discards is exactly what UndrawableExcess returns, so the tests
         assert the two against the same (dimming, gain) pairs and would catch either half drifting
         into double-counting or into a gap. -->
    <Compile Include="../../Source/SnowGlareMath.cs" Link="SnowGlareMath.cs" />
    <!-- §24's roof mask. Independent of SnowGlareMath above — it answers "which cells" while that
         one answers "how bright" — but linked here for the same reason: its failure mode is a quiet
         off-by-one that leaks glare under the eaves, which no screenshot of a 250x250 map resolves. -->
    <Compile Include="../../Source/OpenSkyMaskMath.cs" Link="OpenSkyMaskMath.cs" />
    <!-- Issue #12's per-frame geometry memo. Verse-free by design (the live half that reads
         Time.frameCount / the tick / the mode flags lives in Source/FrameStamp.cs), so its
         hit/miss/invalidation rules are unit tested offline instead of inferred from in-game
         symptoms — a memo bug looks exactly like a formula bug from the outside. -->
    <Compile Include="../../Source/GeometryMemo.cs" Link="GeometryMemo.cs" />
    <!-- §23's cloud-base underlighting (issue #88, option 1). Depends on SkyColorTemperature above
         for NightFadeFloorDegrees — the same public constant PurpleLightMath already reads rather
         than a second copy of "where civil twilight ends" — so that link is a hard prerequisite. -->
    <Compile Include="../../Source/CloudUnderlightMath.cs" Link="CloudUnderlightMath.cs" />
    <!-- §23b's underlit-cloud field (issue #88, option 2). Depends on AuroraNoise, already linked
         above for §11a — the same tileable value noise, deliberately not a second copy of it. -->
    <Compile Include="../../Source/CloudField.cs" Link="CloudField.cs" />
    <!-- §25e's parallel-bake helper. Linked here rather than left to the live build because the
         one thing worth asserting about a parallel bake is that it produces what the serial one
         produced, and that assertion has to be able to call it. It is BCL-only for exactly this
         reason — no UnityEngine, no Verse — despite living beside the adapters. -->
    <Compile Include="../../Source/CloudBake.cs" Link="CloudBake.cs" />
    <!-- §23c's daylight cloud shadows and §25's drawn sheet — the other two consumers of the field
         above. Neither depends on the other; both are here rather than beside their own tests because
         this list is ordered by dependency, and their only dependency is CloudField. -->
    <Compile Include="../../Source/CloudShadowMath.cs" Link="CloudShadowMath.cs" />
    <Compile Include="../../Source/CloudSheetMath.cs" Link="CloudSheetMath.cs" />
    <!-- The Clouds interop's policy half: which cloud lanes stand down when another mod is
         drawing the clouds. Pure, so the ruling is pinned offline rather than only on screen. -->
    <Compile Include="../../Source/CloudsCompatMath.cs" Link="CloudsCompatMath.cs" />
    <!-- §25b's cloud varieties: the deck table, the mixture that decomposes §13's single classified
         deck altitude into it, and the per-sheet deck draw. Depends on BOTH CloudUnderlightMath
         (for ShadowEntryDepressionDegrees — deliberately delegated rather than a third copy of the
         Earth-shadow geometry) and WeatherDimmingMath (for the two default deck altitudes it anchors
         the mixture on), so it must come after both. -->
    <Compile Include="../../Source/CloudDeckMath.cs" Link="CloudDeckMath.cs" />
    <!-- §25's sheet placement: where the bounded clouds are and how they move. Depends on
         CloudDeckMath above, which sets a placed sheet's size, speed and opacity from its deck;
         CloudSheetLayoutTests drives it alongside CloudSheetMath's overlap cap, because the two
         halves of "overlapping clouds read as thicker" live one in each file. -->
    <Compile Include="../../Source/CloudSheetLayout.cs" Link="CloudSheetLayout.cs" />
    <!-- §25c's volumetric cloud (issue #144), in dependency order: the baked volume and its constants
         first, then the view-ray march that reads them. CloudVolumeMath needs CloudField above for
         the UNSTRETCHED coverage its vertical profile is carved from — the whole correction over the
         height field it replaced — and AuroraNoise for the 3-D fBm that erodes it, both already
         linked. CloudRaymarchMath then shares that file's volume layout, extinction and deck
         thicknesses rather than restating them, so it must come after it. -->
    <Compile Include="../../Source/CloudVolumeMath.cs" Link="CloudVolumeMath.cs" />
    <Compile Include="../../Source/CloudRaymarchMath.cs" Link="CloudRaymarchMath.cs" />
    <!-- §28's cadence split for the volumetric sheet's shader uniforms. Last of the cloud files:
         it reads CloudRaymarchMath's two extinction coefficients and its ambient wrap directly, so
         it must come after that, and it also needs CloudSheetLayout above for the atlas-cell
         geometry its callers hand it. Linked because the claim the tests exist to pin — that a
         sheet's Geometry depends on its placement and deck and on NOTHING else — is what makes
         CloudVolumeShader.Configure's per-slot write cache correct. -->
    <Compile Include="../../Source/CloudVolumeUniforms.cs" Link="CloudVolumeUniforms.cs" />
    <!-- Subsystem 27 pure core (vector light sources). Verse-free and standalone — it depends on
         nothing else here, since a visibility polygon is answered entirely from a blocker grid and a
         light position. Tools/VectorLightPreview links the same file for offline look-dev. -->
    <Compile Include="../../Source/VectorLightMath.cs" Link="VectorLightMath.cs" />
  </ItemGroup>

</Project>
