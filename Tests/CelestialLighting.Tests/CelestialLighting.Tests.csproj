<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Links the actual shipped Source/Formulas.cs into this project (not a copy) so the pure
       formula unit tests exercise exactly the code that runs inside RimWorld. Formulas.cs has no
       UnityEngine/Verse dependency, so it compiles cleanly under net8.0 as-is. -->
  <ItemGroup>
    <Compile Include="../../Source/Formulas.cs" Link="Formulas.cs" />
    <Compile Include="../../Source/PenumbraMath.cs" Link="PenumbraMath.cs" />
    <Compile Include="../../Source/MoonMath.cs" Link="MoonMath.cs" />
    <!-- Subsystem 6b pure core (absolute illuminance in lux, and the shadow contrast that follows
         from it). MoonMath depends on it for moon-shadow strength, and it depends on Formulas for
         the shared refraction horizon — both already linked above. -->
    <Compile Include="../../Source/IlluminanceMath.cs" Link="IlluminanceMath.cs" />
    <Compile Include="../../Source/NightRadianceMath.cs" Link="NightRadianceMath.cs" />
    <!-- §18b's vacuum arm of the night floor. Sits below NightRadianceMath (which dispatches into
         it) and above IlluminanceMath (whose lux anchors the planetshine integral samples). -->
    <Compile Include="../../Source/VacuumRadianceMath.cs" Link="VacuumRadianceMath.cs" />
    <Compile Include="../../Source/PurkinjeMath.cs" Link="PurkinjeMath.cs" />
    <!-- §9's per-cell half. Depends on PurkinjeMath above for its lit-exempt anchor, so the two are
         linked together and tested together. -->
    <Compile Include="../../Source/NightDesaturationMath.cs" Link="NightDesaturationMath.cs" />
    <!-- §9's scratch lattice. Verse-free by design (the glow reads happen in the layer and are handed
         in), so the equivalence test can drive the real vertex loop offline. Depends on
         NightDesaturationMath above for CellWash and WashAlpha. -->
    <Compile Include="../../Source/NightWashWindow.cs" Link="NightWashWindow.cs" />
    <!-- Subsystem 13 pure core (weather dimming). Verse-free, so it compiles under net8.0 as-is.
         WeatherDimmingMathTests also exercises PurkinjeMath above, since §13's whole purpose is to
         feed §9 an apparent brightness that finally varies with weather. -->
    <Compile Include="../../Source/WeatherDimmingMath.cs" Link="WeatherDimmingMath.cs" />
    <Compile Include="../../Source/MapSkyMath.cs" Link="MapSkyMath.cs" />
    <!-- Subsystem 8 pure core. Depends on Formulas.AtmosphericRefractionDegrees, so Formulas.cs
         above must be linked too (it already is). -->
    <Compile Include="../../Source/SkyColorTemperature.cs" Link="SkyColorTemperature.cs" />
    <Compile Include="../../Source/AuroraMath.cs" Link="AuroraMath.cs" />
    <Compile Include="../../Source/EclipseMath.cs" Link="EclipseMath.cs" />
    <!-- §18e's vacuum eclipse response. Depends on EclipseMath above (it samples the same
         disc-overlap coverage ramp the shipped patch drives) and on NightRadianceMath, whose §7a
         glow->screen curve it reuses rather than inventing a second one. -->
    <Compile Include="../../Source/VacuumEclipseMath.cs" Link="VacuumEclipseMath.cs" />
    <Compile Include="../../Source/EclipseStaging.cs" Link="EclipseStaging.cs" />
    <Compile Include="../../Source/EclipseModeRules.cs" Link="EclipseModeRules.cs" />
    <Compile Include="../../Source/EclipseSettings.cs" Link="EclipseSettings.cs" />
    <Compile Include="../../Source/BloodMoonMath.cs" Link="BloodMoonMath.cs" />
    <Compile Include="../../Source/CelestialSettingsMath.cs" Link="CelestialSettingsMath.cs" />
    <!-- Subsystem 7b pure core (indoor sky occlusion). Verse-free, so it compiles under net8.0 as-is. -->
    <Compile Include="../../Source/IndoorOcclusionMath.cs" Link="IndoorOcclusionMath.cs" />
    <!-- §7b's baked verdict window: geometry, storage and reads only, so it is Verse-free too and the
         lattice-equivalence tests can drive the real shipped buffer rather than a stand-in. -->
    <Compile Include="../../Source/SkyOcclusionWindow.cs" Link="SkyOcclusionWindow.cs" />
    <!-- Subsystem 14 pure core (sun-clock reconciliation). Depends on Formulas.cs, already linked. -->
    <Compile Include="../../Source/SunClockMath.cs" Link="SunClockMath.cs" />
    <!-- Subsystem 18d pure core (limb refraction on vacuum maps). Depends on Formulas for the
         sea-level refraction horizon it measures its sunlit overshoot against, on SunClockMath
         (directly above) for the elevation->glow curve it re-references to the platform's own
         horizon, and on BloodMoonMath for the Rec. 601 luma weights — all three already linked. -->
    <Compile Include="../../Source/LimbRefractionMath.cs" Link="LimbRefractionMath.cs" />
    <!-- Subsystem 15 pure core (eaves). Verse-free, so it compiles under net8.0 as-is. Shared by
         §4's shadow mesh and §7b's occlusion, which is the whole reason it is its own file. -->
    <Compile Include="../../Source/EavesMath.cs" Link="EavesMath.cs" />
    <!-- Subsystem 15b pure core (how dark the ground under an eave is). Reads one constant off
         IndoorOcclusionMath, already linked above. -->
    <Compile Include="../../Source/EaveShadeMath.cs" Link="EaveShadeMath.cs" />
    <!-- Subsystem 18c pure core (what fills a shadow: skylight at sea level, the night light budget
         in vacuum). Reads EaveShadeMath's Rec. 709 helper above so there is one copy of those
         weights, and its tests read NightRadianceMath's floor constants so the vacuum umbra is
         pinned to the night budget it consumes rather than to a second copy of it. Both already
         linked above. -->
    <Compile Include="../../Source/ShadowFillMath.cs" Link="ShadowFillMath.cs" />
    <!-- Issue #12's per-frame geometry memo. Verse-free by design (the live half that reads
         Time.frameCount / the tick / the mode flags lives in Source/FrameStamp.cs), so its
         hit/miss/invalidation rules are unit tested offline instead of inferred from in-game
         symptoms — a memo bug looks exactly like a formula bug from the outside. -->
    <Compile Include="../../Source/GeometryMemo.cs" Link="GeometryMemo.cs" />
  </ItemGroup>

</Project>
