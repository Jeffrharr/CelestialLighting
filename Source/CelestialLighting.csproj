<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>CelestialLighting</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <OutputPath>../1.6/Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <!-- Compile-time only: we depend on the standalone brrainz.harmony Workshop mod (declared as a
         hard <modDependencies> requirement in About.xml) providing 0Harmony.dll at runtime instead
         of bundling our own copy, which would risk two different Harmony versions loading into the
         same AppDomain if another mod also bundles its own. This matches the sibling MapFeatureEvents
         mod's reference form. 0Harmony is not strong-named (PublicKeyToken=null), so Mono ignores the
         AssemblyVersion baked into our reference and binds to whatever 0Harmony is loaded — the exact
         "2.3.*"-vs-installed version does not matter. What DOES matter is that brrainz.harmony loads
         *before* us: its Manifest declares <loadBefore>Core</loadBefore>, and our About.xml lists it
         in <modDependencies>/<loadAfter>, so mod managers order it first. If those attributes aren't
         yet loaded when RimWorld reads our [HarmonyPatch] custom attributes, resolution fails with a
         TypeLoadException that misleadingly names our reference's version — that is a load-order
         symptom, not a version mismatch. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Probes/ implements RimWorldTestHarness.Mod.Probes.IProbe for the dev-only live test
         harness. The shipped mod DLL must never reference that harness, so this file is compiled
         separately into ../TestMod/CelestialLighting.Probes.csproj instead — see
         RimWorldTestHarness/DESIGN.md's "Where probe tests live". -->
    <Compile Remove="Probes/**/*.cs" />
  </ItemGroup>
</Project>
