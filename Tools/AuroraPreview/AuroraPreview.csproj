<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>AuroraPreview</AssemblyName>
    <RootNamespace>CelestialLighting.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The whole point of this tool: it renders the SHIPPED field generator, linked as source, not a
         reimplementation of it. AuroraCurtain also owns the layer geometry (feature sizes, pan rates,
         second-layer alpha) precisely so the composite below can be faithful rather than a lookalike. -->
    <Compile Include="../../Source/AuroraMath.cs" Link="AuroraMath.cs" />
    <Compile Include="../../Source/AuroraNoise.cs" Link="AuroraNoise.cs" />
    <Compile Include="../../Source/AuroraCurtain.cs" Link="AuroraCurtain.cs" />
    <!-- The alternative shape function under evaluation (issue #42, DESIGN.md 11a). Linked alongside
         the contour field rather than instead of it: the only useful output of this tool while the
         two are competing is both of them rendered from the same code at the same instant. -->
    <Compile Include="../../Source/AuroraCurtainHemRays.cs" Link="AuroraCurtainHemRays.cs" />
    <Compile Include="../../Source/AuroraFieldSpec.cs" Link="AuroraFieldSpec.cs" />
    <Compile Include="../../Source/AuroraSheetLayout.cs" Link="AuroraSheetLayout.cs" />
  </ItemGroup>
</Project>
