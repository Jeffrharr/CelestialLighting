<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CelestialLighting.Tools</RootNamespace>
    <AssemblyName>WeatherAudit</AssemblyName>
  </PropertyGroup>

  <!-- Links the SHIPPED classifier rather than reimplementing it, the same discipline
       Tests/CelestialLighting.Tests uses. The whole value of this tool is that its verdicts are the
       game's verdicts; a second copy of the formula would drift and then lie. WeatherDimmingMath has
       no UnityEngine/Verse dependency, so it compiles under net8.0 as-is. -->
  <ItemGroup>
    <Compile Include="../../Source/WeatherDimmingMath.cs" Link="WeatherDimmingMath.cs" />
  </ItemGroup>

</Project>
