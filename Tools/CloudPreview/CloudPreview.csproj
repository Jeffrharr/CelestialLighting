<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>CloudPreview</AssemblyName>
    <RootNamespace>CelestialLighting.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same premise as AuroraPreview next door, and it exists for the same reason that one does: the
         only question this answers is "what does the SHIPPED field look like", so it links the shipped
         file as source rather than reimplementing it. A Python lookalike would drift from the game the
         first time a constant moved, and the whole point is to iterate on those constants. -->
    <Compile Include="../../Source/AuroraNoise.cs" Link="AuroraNoise.cs" />
    <Compile Include="../../Source/CloudField.cs" Link="CloudField.cs" />
    <!-- §25b's deck table, so the atlas preview below bakes the rows the game bakes rather than a
         copy of them, and the sunset table reports the shipped windows.

         THE FOUR ABOVE IT ARE A DEPENDENCY CHAIN, NOT A WISHLIST, and it is longer than it looks
         because it terminates in one constant. CloudDeckMath delegates its shadow-entry geometry to
         CloudUnderlightMath rather than re-deriving arccos(R/(R+h)) — the whole point of that
         delegation — and CloudUnderlightMath reads SkyColorTemperature.NightFadeFloorDegrees, which
         drags §8's curve and its own two prerequisites in behind it. Paid rather than stubbed: a
         local copy of any of these is exactly the drift the delegation exists to prevent, and a
         preview tool showing different numbers from the game is worse than no preview tool. -->
    <Compile Include="../../Source/Formulas.cs" Link="Formulas.cs" />
    <Compile Include="../../Source/AtmosphericColumn.cs" Link="AtmosphericColumn.cs" />
    <Compile Include="../../Source/AerosolSpectrum.cs" Link="AerosolSpectrum.cs" />
    <Compile Include="../../Source/SkyColorTemperature.cs" Link="SkyColorTemperature.cs" />
    <Compile Include="../../Source/WeatherDimmingMath.cs" Link="WeatherDimmingMath.cs" />
    <Compile Include="../../Source/CloudUnderlightMath.cs" Link="CloudUnderlightMath.cs" />
    <Compile Include="../../Source/CloudDeckMath.cs" Link="CloudDeckMath.cs" />
    <Compile Include="../../Source/CloudSheetMath.cs" Link="CloudSheetMath.cs" />
    <!-- §25c's volumetric shading (issue #144), and the two cores that give it its two colours: §8's
         direct-sun colour for the lit tops and §19c's composed hue for the shaded sides. Both were
         already reachable — PurpleLightMath and OzoneTwilightMath depend only on Formulas and
         SkyColorTemperature, which the chain above already pays for. -->
    <Compile Include="../../Source/OzoneTwilightMath.cs" Link="OzoneTwilightMath.cs" />
    <Compile Include="../../Source/PurpleLightMath.cs" Link="PurpleLightMath.cs" />
    <Compile Include="../../Source/CloudVolumeMath.cs" Link="CloudVolumeMath.cs" />
    <!-- §25c variant D: the same volume, integrated along the view ray per pixel instead of baked.
         It links AFTER CloudVolumeMath because it shares that file's volume layout, its extinction
         constant and its deck thickness table rather than restating them — the volume D marches is
         byte-for-byte the volume A2 bakes, which is what makes the two comparable at all. -->
    <Compile Include="../../Source/CloudRaymarchMath.cs" Link="CloudRaymarchMath.cs" />
    <!-- Borrowed wholesale from AuroraPreview: a dependency-free PNG writer, because System.Drawing is
         not available here and this tool is not worth a package reference. -->
    <Compile Include="../AuroraPreview/Png.cs" Link="Png.cs" />
  </ItemGroup>
</Project>
