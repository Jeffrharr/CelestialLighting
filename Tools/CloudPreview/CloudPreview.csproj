<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>CloudPreview</AssemblyName>
    <RootNamespace>CelestialLighting.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same premise as AuroraPreview next door, and it exists for the same reason that one does: the
         only question this answers is "what does the SHIPPED field look like", so it links the shipped
         file as source rather than reimplementing it. A Python lookalike would drift from the game the
         first time a constant moved, and the whole point is to iterate on those constants. -->
    <Compile Include="../../Source/AuroraNoise.cs" Link="AuroraNoise.cs" />
    <Compile Include="../../Source/CloudField.cs" Link="CloudField.cs" />
    <!-- Borrowed wholesale from AuroraPreview: a dependency-free PNG writer, because System.Drawing is
         not available here and this tool is not worth a package reference. -->
    <Compile Include="../AuroraPreview/Png.cs" Link="Png.cs" />
  </ItemGroup>
</Project>
