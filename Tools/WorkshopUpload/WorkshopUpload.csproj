<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pushes the staged package to the Workshop through the Steamworks API, the same calls RimWorld's
       in-game uploader makes. publish.sh runs it when uploading to Steam. See Program.cs for why not steamcmd.

       Steamworks.NET and libsteam_api.so are taken from the RimWorld install (Private=false) and
       resolved at run time, so the upload goes through the exact Steam bindings the game ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CelestialLighting.Tools</RootNamespace>
    <AssemblyName>WorkshopUpload</AssemblyName>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/RimWorld</RimWorldDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(RimWorldDir)/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

</Project>
