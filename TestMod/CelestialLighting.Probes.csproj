<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>CelestialLighting.Probes</AssemblyName>
    <RootNamespace>CelestialLighting.Probes</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>1.6/Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied: this compiles the exact file CelestialLighting.csproj excludes (see
         its <Compile Remove="Probes/**/*.cs" />), so there is only ever one copy of
         ShadowLeanProbe.cs on disk. -->
    <Compile Include="../Source/Probes/ShadowLeanProbe.cs" Link="ShadowLeanProbe.cs" />
    <Compile Include="../Source/Probes/CivilTwilightProbe.cs" Link="CivilTwilightProbe.cs" />
    <Compile Include="../Source/Probes/PenumbraProbe.cs" Link="PenumbraProbe.cs" />
    <Compile Include="../Source/Probes/MoonIlluminationProbe.cs" Link="MoonIlluminationProbe.cs" />
    <Compile Include="../Source/Probes/NightRadianceProbe.cs" Link="NightRadianceProbe.cs" />
    <Compile Include="../Source/Probes/PurkinjeProbe.cs" Link="PurkinjeProbe.cs" />
    <Compile Include="../Source/Probes/NightDesaturationProbe.cs" Link="NightDesaturationProbe.cs" />
    <Compile Include="../Source/Probes/SkyColorTemperatureProbe.cs" Link="SkyColorTemperatureProbe.cs" />
    <Compile Include="../Source/Probes/AuroraTintProbe.cs" Link="AuroraTintProbe.cs" />
    <Compile Include="../Source/Probes/EclipseCoverageProbe.cs" Link="EclipseCoverageProbe.cs" />
    <Compile Include="../Source/Probes/BloodMoonProbe.cs" Link="BloodMoonProbe.cs" />
    <Compile Include="../Source/Probes/MoonShadowRenderProbe.cs" Link="MoonShadowRenderProbe.cs" />
    <Compile Include="../Source/Probes/MoonElevationProbe.cs" Link="MoonElevationProbe.cs" />
    <Compile Include="../Source/Probes/WeatherDimmingProbe.cs" Link="WeatherDimmingProbe.cs" />
    <Compile Include="../Source/Probes/SkyGlowProbe.cs" Link="SkyGlowProbe.cs" />
    <Compile Include="../Source/Probes/SunClockProbe.cs" Link="SunClockProbe.cs" />
    <Compile Include="../Source/Probes/EaveCellProbe.cs" Link="EaveCellProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only mod, never published — references the built output of two sibling repos rather
         than project references, since neither CelestialLighting.csproj nor
         RimWorldTestHarness.csproj should themselves depend on this one (that dependency only
         goes one direction: this test mod depends on both of them). Build CelestialLighting and
         RimWorldTestHarness first (both build.sh scripts) before building this project. -->
    <Reference Include="CelestialLighting">
      <HintPath>../1.6/Assemblies/CelestialLighting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorldTestHarness">
      <HintPath>../../RimWorldTestHarness/1.6/Assemblies/RimWorldTestHarness.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
