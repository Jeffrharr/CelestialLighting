<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>CelestialLighting.Probes</AssemblyName>
    <RootNamespace>CelestialLighting.Probes</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>1.6/Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Where the harness's built assemblies live. The default resolves when this project is built
         from CelestialLighting's own main checkout. It does NOT resolve from a git worktree: those
         sit a directory deeper under .worktrees/, so the relative path lands on
         .worktrees/RimWorldTestHarness, which does not exist. Override it to build a worktree
         against the harness checkout — or harness worktree — it actually means:

           ./TestMod/build.sh /p:RimWorldTestHarnessDir=/abs/path/to/RimWorldTestHarness

         A property rather than a symlink at that missing path, deliberately: a symlink there is
         global, so one agent pointing it at their harness branch would silently redirect every other
         agent's worktree build to that branch's assemblies. -->
    <RimWorldTestHarnessDir Condition="'$(RimWorldTestHarnessDir)' == ''">../../RimWorldTestHarness</RimWorldTestHarnessDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <!-- Compile-time only, the same form and for the same reason as CelestialLighting.csproj's:
         0Harmony comes from the brrainz.harmony mod at runtime, and shipping a second copy in this
         dev mod's Assemblies folder would load a second Harmony into the AppDomain. Needed because
         GeometryEvalCountProbe counts geometry evaluations by patching the accessors from out here,
         rather than by editing the shipped mod to carry a counter it would then have to ship. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied: this compiles the exact file CelestialLighting.csproj excludes (see
         its <Compile Remove="Probes/**/*.cs" />), so there is only ever one copy of
         ShadowLeanProbe.cs on disk. -->
    <Compile Include="../Source/Probes/ShadowLeanProbe.cs" Link="ShadowLeanProbe.cs" />
    <Compile Include="../Source/Probes/AxialTiltDeclinationProbe.cs" Link="AxialTiltDeclinationProbe.cs" />
    <Compile Include="../Source/Probes/AxialTiltActiveProbe.cs" Link="AxialTiltActiveProbe.cs" />
    <Compile Include="../Source/Probes/AxialTiltLunarProbe.cs" Link="AxialTiltLunarProbe.cs" />
    <Compile Include="../Source/Probes/PlanetsmithActiveProbe.cs" Link="PlanetsmithActiveProbe.cs" />
    <Compile Include="../Source/Probes/PlanetsmithTiltProbe.cs" Link="PlanetsmithTiltProbe.cs" />
    <Compile Include="../Source/Probes/RealisticPlanetsActiveProbe.cs" Link="RealisticPlanetsActiveProbe.cs" />
    <!-- The three files under Probes/ that WRITE rather than read. Two put a steep tilt on the loaded
         world so the Planetsmith and Realistic Planets 2 interops have something a probe can see —
         the files themselves explain why a save fixture cannot supply one. The third is a Harmony
         postfix that forces CloudCoverClock.FractionForMap to a fixed constant, so a scenario gets a
         reproducible cloud fraction instead of depending on which absolute year the harness's clock
         jump lands in. Dev-only by construction, like everything else in this project. -->
    <Compile Include="../Source/Probes/PlanetsmithTiltOverride.cs" Link="PlanetsmithTiltOverride.cs" />
    <Compile Include="../Source/Probes/RealisticPlanetsTiltOverride.cs" Link="RealisticPlanetsTiltOverride.cs" />
    <Compile Include="../Source/Probes/CloudCoverFractionOverride.cs" Link="CloudCoverFractionOverride.cs" />
    <Compile Include="../Source/Probes/CloudsCompatOverride.cs" Link="CloudsCompatOverride.cs" />
    <Compile Include="../Source/Probes/CloudsActiveProbe.cs" Link="CloudsActiveProbe.cs" />
    <Compile Include="../Source/Probes/MoonDeclinationProbe.cs" Link="MoonDeclinationProbe.cs" />
    <Compile Include="../Source/Probes/ShadowVectorXProbe.cs" Link="ShadowVectorXProbe.cs" />
    <Compile Include="../Source/Probes/CivilTwilightProbe.cs" Link="CivilTwilightProbe.cs" />
    <Compile Include="../Source/Probes/MapSkyProbe.cs" Link="MapSkyProbe.cs" />
    <Compile Include="../Source/Probes/CircinusProbe.cs" Link="CircinusProbe.cs" />
    <Compile Include="../Source/Probes/TwilightWarmthProbe.cs" Link="TwilightWarmthProbe.cs" />
    <Compile Include="../Source/Probes/PenumbraProbe.cs" Link="PenumbraProbe.cs" />
    <Compile Include="../Source/Probes/MoonIlluminationProbe.cs" Link="MoonIlluminationProbe.cs" />
    <Compile Include="../Source/Probes/NightRadianceProbe.cs" Link="NightRadianceProbe.cs" />
    <Compile Include="../Source/Probes/PurkinjeProbe.cs" Link="PurkinjeProbe.cs" />
    <Compile Include="../Source/Probes/NightDesaturationProbe.cs" Link="NightDesaturationProbe.cs" />
    <Compile Include="../Source/Probes/SkyColorTemperatureProbe.cs" Link="SkyColorTemperatureProbe.cs" />
    <!-- §20d's two halves. The Angstrom exponent is the INPUT (what size the tile's aerosol
         particles are), the red/blue ratio is the OUTPUT (where the composed sky colour landed).
         Both are needed because they fail independently: a desert tile can read the right exponent
         and still show an unchanged sky if the spectrum is not being applied, and vice versa.
         Deliberately no probe reports the aerosol colour as a Kelvin — once the spectral shape is
         applied the colour is not on the Planckian locus, so any Kelvin would be a fiction. -->
    <Compile Include="../Source/Probes/AerosolAngstromProbe.cs" Link="AerosolAngstromProbe.cs" />
    <Compile Include="../Source/Probes/SkyRedBlueRatioProbe.cs" Link="SkyRedBlueRatioProbe.cs" />
    <!-- §20e (issue #92). The raw column both probes above are downstream of — see
         AerosolLoadProbe.cs for why it is worth reading separately. -->
    <Compile Include="../Source/Probes/AerosolLoadProbe.cs" Link="AerosolLoadProbe.cs" />
    <!-- §19. polar_night_blue reads the shared adapter (never CurSkyTarget, which mutates vanilla's
         >=75-degree slew state as a side effect); overlay_brightness reads the finished material,
         and is the first probe to measure on-screen darkness at all — sky_glow is the GAMEPLAY
         brightness and the two deliberately diverge. -->
    <Compile Include="../Source/Probes/PolarNightBlueProbe.cs" Link="PolarNightBlueProbe.cs" />
    <Compile Include="../Source/Probes/PurpleLightProbe.cs" Link="PurpleLightProbe.cs" />
    <Compile Include="../Source/Probes/OverlayBrightnessProbe.cs" Link="OverlayBrightnessProbe.cs" />
    <!-- §18d's limb-refraction ramp. Four metrics off one class, because a temporal effect
         needs its own sun-elevation x-axis probed alongside the values plotted on it. -->
    <Compile Include="../Source/Probes/LimbRefractionProbe.cs" Link="LimbRefractionProbe.cs" />
    <Compile Include="../Source/Probes/AuroraTintProbe.cs" Link="AuroraTintProbe.cs" />
    <Compile Include="../Source/Probes/AuroraCurtainProbe.cs" Link="AuroraCurtainProbe.cs" />
    <Compile Include="../Source/Probes/AuroraCurtainCostProbe.cs" Link="AuroraCurtainCostProbe.cs" />
    <!-- Issue #60's measurement pass: times the shipped draw path in place, from out here, so the
         shipped assembly never carries the stopwatches. Same arrangement as GeometryEvalCountProbe. -->
    <Compile Include="../Source/Probes/AuroraPathTimingProbe.cs" Link="AuroraPathTimingProbe.cs" />
    <Compile Include="../Source/Probes/EclipseCoverageProbe.cs" Link="EclipseCoverageProbe.cs" />
    <Compile Include="../Source/Probes/EclipseUmbraProbe.cs" Link="EclipseUmbraProbe.cs" />
    <Compile Include="../Source/Probes/BloodMoonProbe.cs" Link="BloodMoonProbe.cs" />
    <Compile Include="../Source/Probes/MoonShadowRenderProbe.cs" Link="MoonShadowRenderProbe.cs" />
    <Compile Include="../Source/Probes/MoonElevationProbe.cs" Link="MoonElevationProbe.cs" />
    <Compile Include="../Source/Probes/WeatherDimmingProbe.cs" Link="WeatherDimmingProbe.cs" />
    <!-- §22. Independent of weather_dimming above — see CloudCoverProbe.cs and its registration
         comment in ProbeRegistration.cs for why the two fractions never move together. -->
    <Compile Include="../Source/Probes/CloudCoverProbe.cs" Link="CloudCoverProbe.cs" />
    <!-- Issue #100: §21's cavity gain, paired with cloud_cover_fraction above so a scenario can show
         the two moving together on a Clear map — see SurfaceBuildupCavityGainProbe.cs's header. -->
    <Compile Include="../Source/Probes/SurfaceBuildupCavityGainProbe.cs" Link="SurfaceBuildupCavityGainProbe.cs" />
    <!-- §23 (issue #88, option 1). Two metrics off one class — see CloudUnderlightProbe.cs's own
         header for why the altitude half is needed alongside the multiplier. -->
    <Compile Include="../Source/Probes/CloudUnderlightProbe.cs" Link="CloudUnderlightProbe.cs" />
    <!-- §23b (issue #88, option 2). Three metrics off one class — the claim is a conjunction, see
         CloudLayersProbe.cs's own header. -->
    <Compile Include="../Source/Probes/CloudLayersProbe.cs" Link="CloudLayersProbe.cs" />
    <Compile Include="../Source/Probes/CloudVolumeShaderProbe.cs" Link="CloudVolumeShaderProbe.cs" />
    <Compile Include="../Source/Probes/CloudSheetViewProbe.cs" Link="CloudSheetViewProbe.cs" />
    <!-- §25's placed-sheet mass, the one cloud reading that moves when a sheet appears or vanishes —
         see CloudSheetMassProbe.cs for why it sums the placements' alphas rather than counting them. -->
    <Compile Include="../Source/Probes/CloudSheetMassProbe.cs" Link="CloudSheetMassProbe.cs" />
    <Compile Include="../Source/Probes/SkyGlowProbe.cs" Link="SkyGlowProbe.cs" />
    <Compile Include="../Source/Probes/SkyOverlayWarmthProbe.cs" Link="SkyOverlayWarmthProbe.cs" />
    <Compile Include="../Source/Probes/SkyOverlayLuminanceProbe.cs" Link="SkyOverlayLuminanceProbe.cs" />
    <Compile Include="../Source/Probes/SunClockProbe.cs" Link="SunClockProbe.cs" />
    <Compile Include="../Source/Probes/EaveCellProbe.cs" Link="EaveCellProbe.cs" />
    <Compile Include="../Source/Probes/SectionRegenerateTimingProbe.cs" Link="SectionRegenerateTimingProbe.cs" />
    <Compile Include="../Source/Probes/GeometryEvalCountProbe.cs" Link="GeometryEvalCountProbe.cs" />
    <Compile Include="../Source/Probes/SectionLayerDrawCountProbe.cs" Link="SectionLayerDrawCountProbe.cs" />
    <Compile Include="../Source/Probes/ShadowExtrusionProbe.cs" Link="ShadowExtrusionProbe.cs" />
    <!-- §21's cavity gain, read from the live map — see the file header for why a screenshot A/B
         alone cannot distinguish a genuinely small lift from no lift at all. -->
    <Compile Include="../Source/Probes/SurfaceCavityGainProbe.cs" Link="SurfaceCavityGainProbe.cs" />
    <Compile Include="../Source/Probes/SnowGlareProbe.cs" Link="SnowGlareProbe.cs" />
    <Compile Include="../Source/Probes/SnowGlareExcessProbe.cs" Link="SnowGlareExcessProbe.cs" />
    <!-- Issue #80: the near-door cell probe, paired GroundGlow (gameplay) vs
         SkyFraction (what §7b's CapOcclusion actually consumes) — see the file header for why both
         are needed. -->
    <Compile Include="../Source/Probes/AmbientLightDoorCellProbe.cs" Link="AmbientLightDoorCellProbe.cs" />
    <!-- Reads §7b's baked lighting-overlay vertex alphas directly, which is the only way to tell "the
         classification is right" apart from "the classification is right AND the bake reached the
         mesh". Used by glass_wall_leak.json for the ReBuild: Doors and Corners glass-wall interop. -->
    <Compile Include="../Source/Probes/SkyCoverVertexProbe.cs" Link="SkyCoverVertexProbe.cs" />
    <!-- The ground/artificial/sky split behind IndoorGlowPassthrough at an arbitrary cell. Used by
         indoor_glow_lamp.json to prove a lamp-lit sealed room keeps SkyFraction at 0 while its
         GroundGlow stays high — the regression that would otherwise put dawn pink on a windowless
         workshop. -->
    <Compile Include="../Source/Probes/IndoorGlowCellProbe.cs" Link="IndoorGlowCellProbe.cs" />
    <!-- Issue #124 / §7c: the native BFS's own copy of the same near-door cell, paired Depth (raw BFS
         layer) vs Fraction (what SkyFalloffSource actually dispatches to CapOcclusion) — see the file
         header for why both are needed. -->
    <Compile Include="../Source/Probes/NativeSkyFalloffProbe.cs" Link="NativeSkyFalloffProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only mod, never published — references the built output of two sibling repos rather
         than project references, since neither CelestialLighting.csproj nor
         RimWorldTestHarness.csproj should themselves depend on this one (that dependency only
         goes one direction: this test mod depends on both of them). Build CelestialLighting and
         RimWorldTestHarness first (both build.sh scripts) before building this project. -->
    <Reference Include="CelestialLighting">
      <HintPath>../1.6/Assemblies/CelestialLighting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorldTestHarness">
      <HintPath>$(RimWorldTestHarnessDir)/1.6/Assemblies/RimWorldTestHarness.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The harness's game-type-free half, where the registries that must stay unit-testable live
         (WorldOverrideHookRegistry). A separate assembly rather than part of the one above, so
         referencing it explicitly is required even though both ship in the same Assemblies folder. -->
    <Reference Include="RimWorldTestHarness.Shared">
      <HintPath>$(RimWorldTestHarnessDir)/1.6/Assemblies/RimWorldTestHarness.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
